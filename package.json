{
  "name": "nicobookings",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/frontend",
    "apps/admin"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:api": "bun run --filter @nicobookings/api dev",
    "dev:frontend": "bun run --filter @nicobookings/frontend dev",
    "dev:admin": "bun run --filter @nicobookings/admin dev",
    "db:generate": "bun run --filter=@nicobookings/api db:generate",
    "build": "bun run db:generate && bun run --filter=@nicobookings/frontend build && bun run --filter=@nicobookings/admin build",
    "test:e2e": "playwright test",
    "test:e2e:headless": "E2E_HEADLESS=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
