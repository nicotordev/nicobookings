{
  "name": "nicobookings",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/frontend",
    "apps/admin"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:api": "bun run --filter @nicobookings/api dev",
    "dev:frontend": "bun run --filter @nicobookings/frontend dev",
    "dev:admin": "bun run --filter @nicobookings/admin dev",
    "build": "bun run --filter @nicobookings/frontend build && bun run --filter @nicobookings/admin build"
  }
}
