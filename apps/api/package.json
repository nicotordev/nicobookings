{
  "name": "@nicobookings/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=.env ./node_modules/.bin/prisma generate",
    "db:validate": "bun --env-file=.env ./node_modules/.bin/prisma validate",
    "db:migrate": "bun --env-file=.env ./node_modules/.bin/prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}
